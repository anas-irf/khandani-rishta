# Template for /etc/khandani/api.env on the VM (owner root, group khandani, mode 640).
# Never commit the real file. Keep a copy in your password manager.
# systemd reads this file: keep comments on their own lines, not after a value.

APP_ENV=production
BIND_ADDR=127.0.0.1:8080

# Percent-encode special characters in the password.
DATABASE_URL=postgres://khandani_prod:<password>@<server>.postgres.database.azure.com:5432/khandani_prod?sslmode=verify-full

DATABASE_MAX_CONNECTIONS=10

# Web origins of this environment
CORS_ALLOWED_ORIGINS=https://khandanirishta.app,https://www.khandanirishta.app

LOG_FORMAT=json
RUST_LOG=info

# Sentry project DSN (leave empty to disable)
SENTRY_DSN=

# ---- Clerk (specs/06-auth-and-accounts.md section 13.1) ----
# Frontend API URL of the Clerk instance. Must equal the token's iss. No trailing slash.
CLERK_ISSUER=https://clerk.khandanirishta.app
# Optional override; defaults to <CLERK_ISSUER>/.well-known/jwks.json
CLERK_JWKS_URL=
# Comma-separated web origins accepted in the token's azp claim
CLERK_AUTHORIZED_PARTIES=https://khandanirishta.app,https://www.khandanirishta.app
# Backend API key (secret)
CLERK_SECRET_KEY=sk_live_...
# Backend API base
CLERK_API_BASE_URL=https://api.clerk.com/v1
# Signing secret of this environment's webhook endpoint (secret).
CLERK_WEBHOOK_SECRET=whsec_...
# true only when the Clerk plan includes user bans
CLERK_BAN_ENABLED=false

# ---- Identity numbers (specs/20-non-functional.md section 2.1) ----
# 32 random bytes, base64: openssl rand -base64 32. Different values per environment.
# Losing the encryption key makes stored numbers unreadable; keep both in the password manager.
# The API refuses to start when either is missing or not 32 bytes.
IDENTITY_ENCRYPTION_KEY=
IDENTITY_HASH_PEPPER=
# Only while rotating the encryption key
IDENTITY_ENCRYPTION_KEY_PREVIOUS=

# ---- Cloudflare R2 (photos and verification images). Empty turns uploads off ----
R2_ENDPOINT=https://<account id>.r2.cloudflarestorage.com
R2_BUCKET_MEDIA=kr-prod-media
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# ---- Azure AI Content Safety. Empty sends everything to the manual review queues ----
AZURE_CONTENT_SAFETY_ENDPOINT=
AZURE_CONTENT_SAFETY_KEY=

# ---- Email through Resend. Empty turns email off ----
RESEND_API_KEY=
EMAIL_FROM=Khandani Rishta <no-reply@khandanirishta.app>

# ---- Android push through Firebase Cloud Messaging. Empty turns push off ----
FCM_PROJECT_ID=
# The service account key as one line of JSON in single quotes (secret). systemd drops the
# backslash of every unquoted "\n", which would break the private key.
FCM_SERVICE_ACCOUNT_JSON=

# Origin of the web app, used in emails and share links
WEB_BASE_URL=https://khandanirishta.app
