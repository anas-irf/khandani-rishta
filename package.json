{
  "name": "khandani-rishta",
  "private": true,
  "packageManager": "pnpm@12.21.0",
  "scripts": {
    "prepare": "husky",
    "bootstrap": "node scripts/bootstrap.mjs",
    "db:start": "docker compose -f infra/local/docker-compose.yml up -d --wait",
    "db:stop": "docker compose -f infra/local/docker-compose.yml down",
    "dev:web": "pnpm --filter @khandani/web dev",
    "build:web": "pnpm --filter @khandani/web build",
    "generate:api-client": "pnpm --filter @khandani/api-contract generate",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "pnpm --recursive --parallel typecheck",
    "knip": "knip",
    "test": "pnpm --recursive test",
    "test:e2e": "pnpm build:web && pnpm --filter @khandani/e2e e2e",
    "check": "pnpm lint && pnpm typecheck && pnpm knip && pnpm test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "husky": "^9.1.7",
    "knip": "^6.46.1",
    "lint-staged": "^17.6.1"
  }
}
