# Copy to .env.local for local development. Never commit real values.
# VITE_ variables are public: they are baked into the browser bundle at build time.

# Base URL of the API
VITE_API_BASE_URL=http://localhost:8787

# Clerk publishable key of the development instance (pk_test_...). `npx clerk env pull`
# prints it, or copy it from the Clerk dashboard under API keys.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_replace_me

# local, staging or production
VITE_APP_ENV=local

# Sentry DSN of the web project, used by the browser and the Worker. Empty disables reporting.
VITE_SENTRY_DSN=
