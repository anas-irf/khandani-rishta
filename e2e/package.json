{
  "name": "@khandani/e2e",
  "private": true,
  "type": "module",
  "description": "Playwright end-to-end tests. They run against a local build of the web app, or against a deployed site when E2E_BASE_URL is set.",
  "scripts": {
    "e2e": "playwright test",
    "e2e:smoke": "playwright test --grep @smoke",
    "e2e:report": "playwright show-report",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "@typescript/native": "npm:typescript@^7.0.2"
  }
}
