# Template for /etc/khandani/backup.env on the production VM only
# (owner root, group khandani, mode 640). Never commit the real file.

# PostgreSQL connection, read by pg_dump
PGHOST=<server>.postgres.database.azure.com
PGPORT=5432
PGDATABASE=khandani_prod
PGUSER=khandani_prod
PGPASSWORD=
PGSSLMODE=verify-full
PGSSLROOTCERT=system

# Cloudflare R2: use an API token limited to Object Read & Write on the backups bucket
BACKUP_BUCKET=kr-backups
RCLONE_CONFIG_R2_TYPE=s3
RCLONE_CONFIG_R2_PROVIDER=Cloudflare
RCLONE_CONFIG_R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
RCLONE_CONFIG_R2_ACCESS_KEY_ID=
RCLONE_CONFIG_R2_SECRET_ACCESS_KEY=
RCLONE_CONFIG_R2_NO_CHECK_BUCKET=true
