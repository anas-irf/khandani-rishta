{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "khandani-web",
  "compatibility_date": "2026-11-18",
  "compatibility_flags": ["nodejs_compat"],
  // src/server.ts wraps TanStack Start's handler with Sentry (17 section 15).
  "main": "src/server.ts",
  // Gives Sentry the deployed version id as the release name.
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  // Non-secret variables for the Worker (17 section 15). CLERK_SECRET_KEY is a secret:
  // `wrangler secret put CLERK_SECRET_KEY --env <env>`.
  "vars": {
    "CLERK_SIGN_IN_URL": "/sign-in",
    "CLERK_SIGN_UP_URL": "/sign-in",
    "CLERK_SIGN_IN_FALLBACK_REDIRECT_URL": "/home",
    "CLERK_SIGN_UP_FALLBACK_REDIRECT_URL": "/home"
  },
  "observability": {
    "enabled": true
  },
  // Production is the only deployed environment.
  "routes": [
    { "pattern": "khandanirishta.app", "custom_domain": true },
    { "pattern": "www.khandanirishta.app", "custom_domain": true }
  ]
}
