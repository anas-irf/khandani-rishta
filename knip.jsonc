{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // Finds unused files, exports and dependencies. Run with `pnpm knip`.
  // An export used inside its own file is not reported.
  "ignoreExportsUsedInFile": true,
  "workspaces": {
    ".": {
      "entry": ["scripts/**/*.mjs"],
      // bootstrap.mjs resolves Vite from apps/web; the scripts call Rust and Java tools directly.
      "ignoreDependencies": ["vite"],
      "ignoreBinaries": ["rustc", "rustfmt", "java"]
    },
    "apps/web": {
      "entry": [
        // Public APIs whose unused exports are deliberate: the shadcn/ui primitives, the form
        // fields barrel and the transcribed API contract (src/lib/api-types.ts header).
        "src/components/ui/*.tsx",
        "src/components/common/fields/index.ts",
        "src/lib/api-types.ts",
        // Loaded with import.meta.glob, which Knip cannot follow.
        "src/mocks/handlers/*.ts",
        "src/locales/en/*.json"
      ],
      "project": ["src/**/*.{ts,tsx,css}"]
    },
    "e2e": {
      "project": ["**/*.ts"]
    },
    "packages/api-contract": {}
  }
}
