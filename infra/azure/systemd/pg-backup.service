[Unit]
Description=Dump the production database to Cloudflare R2
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=khandani
Group=khandani
EnvironmentFile=/etc/khandani/backup.env
# The service account has no home directory.
Environment=HOME=/tmp
ExecStart=/opt/khandani/current/bin/pg-backup.sh

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
